#include <winresrc.h>

#define IDI_APPICON 101

IDI_APPICON ICON "calculator.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Microsoft Corporation"
            VALUE "FileDescription",  "Calculator"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "Calculator"
            VALUE "LegalCopyright",   "Copyright (c) Microsoft Corporation. Licensed under the MIT License."
            VALUE "OriginalFilename", "Calculator.exe"
            VALUE "ProductName",      "Windows Calculator"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
