#include <winresrc.h>
#include "version.h"

#define IDI_APPICON 101

IDI_APPICON ICON "calculator.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION CALC_VERSION_COMMA
PRODUCTVERSION CALC_VERSION_COMMA
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Microsoft Corporation"
            VALUE "FileDescription",  "Calculator"
            VALUE "FileVersion",      CALC_VERSION_FULL
            VALUE "InternalName",     "Calculator"
            VALUE "LegalCopyright",   "Copyright (c) Microsoft Corporation. Licensed under the MIT License."
            VALUE "OriginalFilename", "Calculator.exe"
            VALUE "ProductName",      "Windows Calculator"
            VALUE "ProductVersion",   CALC_VERSION_FULL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
