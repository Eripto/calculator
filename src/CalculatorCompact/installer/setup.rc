#include <winresrc.h>
#include "version.h"

101 ICON "calculator.ico"

// The calculator itself, LZMA-packed by tools/pack_payload.py and unpacked on
// install. build.sh stages it where windres can find it.
200 RCDATA "Calculator.exe.cz"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "setup.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION CALC_VERSION_COMMA
PRODUCTVERSION CALC_VERSION_COMMA
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Calculator Setup"
            VALUE "FileVersion",      CALC_VERSION_FULL
            VALUE "InternalName",     "CalculatorSetup"
            VALUE "LegalCopyright",   "Licensed under the MIT License."
            VALUE "OriginalFilename", "CalculatorSetup.exe"
            VALUE "ProductName",      "Calculator (compact build)"
            VALUE "ProductVersion",   CALC_VERSION_FULL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
